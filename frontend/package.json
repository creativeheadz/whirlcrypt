{
  "name": "whirlcrypt-frontend",
  "version": "1.0.0",
  "description": "Frontend for secure file sharing",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "tsx --test tests/*.test.ts",
    "security:audit": "npm audit --audit-level=moderate",
    "security:audit-fix": "npm audit fix",
    "security:socket": "npx @socketsecurity/cli@latest audit",
    "security:deps": "npm run security:audit && npm run security:socket",
    "security:licenses": "npx license-checker --summary"
  },
  "dependencies": {
    "@types/jszip": "^3.4.1",
    "axios": "^1.20.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.55.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^20.1.3",
    "react-router-dom": "^6.14.2"
  },
  "devDependencies": {
    "@socketsecurity/cli": "^1.7.0",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "autoprefixer": "^10.6.1",
    "license-checker": "^25.0.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.0.2",
    "vite": "^4.4.5"
  }
}
